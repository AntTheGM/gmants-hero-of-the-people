<div class="gmants-hero-of-the-people-form gmants-hero-of-the-people-spotlight-form">
  {{!-- Instruction text --}}
  <div class="gmants-hero-of-the-people-spotlight-instruction">
    {{localize "HERO_OF_THE_PEOPLE.Spotlight.Instruction"}}
  </div>

  {{!-- Portrait carousel --}}
  <div class="gmants-hero-of-the-people-spotlight-stage">
    <div class="gmants-hero-of-the-people-spotlight-track">
      {{#each candidates}}
      <div class="gmants-hero-of-the-people-spotlight-card{{#if maxed}} spotlight-maxed{{/if}}" data-actor-id="{{actorId}}">
        <div class="gmants-hero-of-the-people-spotlight-portrait-wrap">
          <img src="{{img}}" alt="{{characterName}}" class="gmants-hero-of-the-people-spotlight-portrait" />
          {{#if maxed}}
          <div class="gmants-hero-of-the-people-spotlight-maxed-badge" title="{{localize "HERO_OF_THE_PEOPLE.Status.AtMax"}}">
            <i class="fas fa-crown"></i>
          </div>
          {{/if}}
        </div>
        <div class="gmants-hero-of-the-people-spotlight-name">{{characterName}}</div>
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- Winner reveal area (hidden until spin completes) --}}
  <div class="gmants-hero-of-the-people-spotlight-reveal" style="display: none;">
    <div class="gmants-hero-of-the-people-spotlight-winner-frame">
      <img src="" alt="" class="gmants-hero-of-the-people-spotlight-winner-portrait" />
    </div>
    <div class="gmants-hero-of-the-people-spotlight-winner-name"></div>
    <div class="gmants-hero-of-the-people-spotlight-winner-phrase"></div>
  </div>

  {{!-- GM controls (hidden for viewers) --}}
  {{#unless isViewer}}
  <div class="gmants-hero-of-the-people-spotlight-gm-row">
    <label class="gmants-hero-of-the-people-spotlight-override-label">
      <i class="fas fa-crosshairs"></i> {{localize "HERO_OF_THE_PEOPLE.Spotlight.OverrideLabel"}}
    </label>
    <select class="gmants-hero-of-the-people-spotlight-override-select" name="spotlight-override">
      <option value="random">{{localize "HERO_OF_THE_PEOPLE.Button.Random"}}</option>
      {{#each candidates}}
      {{#unless maxed}}
      <option value="{{actorId}}">{{characterName}}</option>
      {{/unless}}
      {{/each}}
    </select>
  </div>
  <button type="button" class="gmants-hero-of-the-people-primary-btn" data-action="spin">
    <i class="fas fa-star"></i> {{localize "HERO_OF_THE_PEOPLE.Spotlight.Spin"}}
  </button>
  {{/unless}}
</div>
