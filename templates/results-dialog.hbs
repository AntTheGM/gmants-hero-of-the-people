<div class="gmants-hero-of-the-people-form">
  {{!-- Winner highlight --}}
  <div class="gmants-hero-of-the-people-winner-card">
    {{#if results.winnerImg}}
    <img class="gmants-hero-of-the-people-winner-avatar" src="{{results.winnerImg}}" alt="{{results.winnerName}}" />
    {{/if}}
    <div class="gmants-hero-of-the-people-winner-info">
      <span class="gmants-hero-of-the-people-winner-label">{{localize "HERO_OF_THE_PEOPLE.Results.Winner"}}</span>
      <span class="gmants-hero-of-the-people-winner-name">{{results.winnerName}}</span>
      <span class="gmants-hero-of-the-people-winner-player">{{results.winnerPlayerName}}</span>
    </div>
    <div class="gmants-hero-of-the-people-winner-votes">
      {{results.voteCount}} / {{results.totalVotes}}
      <span class="gmants-hero-of-the-people-votes-label">{{localize "HERO_OF_THE_PEOPLE.Results.Votes"}}</span>
    </div>
  </div>

  {{!-- Vote breakdown --}}
  <div class="gmants-hero-of-the-people-section">
    <div class="gmants-hero-of-the-people-section-header">
      <label>{{localize "HERO_OF_THE_PEOPLE.Results.Breakdown"}}</label>
    </div>
    <div class="gmants-hero-of-the-people-breakdown-list">
      {{#each results.breakdown}}
      <div class="gmants-hero-of-the-people-breakdown-row">
        <span class="gmants-hero-of-the-people-breakdown-voter">{{voterName}}</span>
        <i class="fas fa-arrow-right gmants-hero-of-the-people-breakdown-arrow"></i>
        <span class="gmants-hero-of-the-people-breakdown-target">{{targetName}}</span>
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- Hero Hype section (if any hype was submitted) --}}
  {{#if hasHype}}
  <div class="gmants-hero-of-the-people-section">
    <div class="gmants-hero-of-the-people-section-header">
      <label><i class="fas fa-fire"></i> {{localize "HERO_OF_THE_PEOPLE.Hype.Title"}}</label>
    </div>
    <div class="gmants-hero-of-the-people-hype-list">
      {{#each hypeEntries}}
      <div class="gmants-hero-of-the-people-hype-entry">
        <div class="gmants-hero-of-the-people-hype-entry-target">
          <strong>{{targetName}}</strong>
        </div>
        {{#if tags.length}}
        <div class="gmants-hero-of-the-people-hype-entry-tags">
          {{#each tags}}
          <span class="gmants-hero-of-the-people-hype-badge"><i class="{{icon}}"></i> {{label}}</span>
          {{/each}}
        </div>
        {{/if}}
        {{#if message}}
        <div class="gmants-hero-of-the-people-hype-entry-message">&ldquo;{{message}}&rdquo;</div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    <button type="button" class="gmants-hero-of-the-people-secondary-btn" data-action="postHype">
      <i class="fas fa-bullhorn"></i> {{localize "HERO_OF_THE_PEOPLE.Hype.PostToChat"}}
    </button>
  </div>
  {{/if}}

  {{!-- Action buttons --}}
  <div class="gmants-hero-of-the-people-action-buttons">
    <button type="button" class="gmants-hero-of-the-people-primary-btn" data-action="accept">
      <i class="fas fa-check"></i> {{localize "HERO_OF_THE_PEOPLE.Button.Accept"}}
    </button>
  </div>

  {{!-- Override section --}}
  <div class="gmants-hero-of-the-people-section">
    <div class="gmants-hero-of-the-people-section-header">
      <label>{{localize "HERO_OF_THE_PEOPLE.Button.Override"}}</label>
    </div>
    <div class="gmants-hero-of-the-people-override-row">
      <select class="gmants-hero-of-the-people-override-select">
        {{#each overrideCandidates}}
        <option value="{{actorId}}" {{#if isWinner}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
      <button type="button" class="gmants-hero-of-the-people-secondary-btn" data-action="override">
        <i class="fas fa-crown"></i> {{localize "HERO_OF_THE_PEOPLE.Button.Override"}}
      </button>
    </div>
  </div>
</div>
